# 域名已解析到服务器时填写 quote.example.com，可自动申请 HTTPS。
# 暂时没有域名时填写 :80，通过 http://服务器IP 访问。
SITE_ADDRESS=:80

DATA_ROOT=/data/quoteflow

# scripts/deploy.sh 首次运行时自动生成以下安全值。
POSTGRES_PASSWORD=replace-me
SESSION_SECRET=replace-me
EXPORT_RENDER_TOKEN=replace-me
BACKUP_ENCRYPTION_KEY=replace-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://quote.example.com/api/backups/google/callback
INITIAL_ADMIN_EMAIL=admin@quoteflow.local
INITIAL_ADMIN_PASSWORD=replace-me
INITIAL_ADMIN_NAME=系统管理员
INITIAL_SALESPERSON_EMAIL=mandy@quoteflow.local
INITIAL_SALESPERSON_PASSWORD=replace-me
INITIAL_SALESPERSON_NAME=Mandy zang
